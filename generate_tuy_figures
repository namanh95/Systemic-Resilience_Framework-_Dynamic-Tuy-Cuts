"""
Colab-ready script to generate three figures for:

"Systemic Resilience as Geometric Navigability:
 A Stochastic Control Framework with Dynamic Tuy Cuts"

This version upgrades the earlier draft by making Figure 3 come from the same
discrete routing simulation used to build the geometric landscape in Figure 2.

Dependencies:
    numpy, matplotlib, networkx

Outputs:
    figure1_network_setup.png
    figure2_geometric_cut.png
    figure3_time_series_proof.png
    simulation_summary.csv

How to run in Colab:
    1. Upload this file.
    2. Run: !python generate_tuy_figures_colab.py
"""

from __future__ import annotations

from dataclasses import dataclass
from pathlib import Path
import csv
import math

import matplotlib.pyplot as plt
import networkx as nx
import numpy as np


# ---------------------------
# Global configuration
# ---------------------------
OUTPUT_DIR = Path(".")
RNG = np.random.default_rng(42)

DEMAND = 10.0
GRID_STEP = 0.1
TIME_STEPS = 60
DISRUPTION_TIME = 18

# Base capacities (pre-disruption)
BASE_CAPACITY_PRIMARY = 7.5
BASE_CAPACITY_BACKUP = 5.8
BASE_CAPACITY_CONSOLIDATION = 6.8


@dataclass
class SimulationResult:
    t: np.ndarray
    shock: np.ndarray
    primary_capacity: np.ndarray
    local_cost: np.ndarray
    tuy_cost: np.ndarray
    local_x1: np.ndarray
    local_x2: np.ndarray
    tuy_x1: np.ndarray
    tuy_x2: np.ndarray


# ---------------------------
# Helpers: feasible grid
# ---------------------------
def generate_feasible_grid(demand: float = DEMAND, step: float = GRID_STEP) -> np.ndarray:
    points = []
    n = int(round(demand / step))
    for i in range(n + 1):
        x1 = i * step
        for j in range(n + 1 - i):
            x2 = j * step
            points.append((x1, x2))
    return np.array(points, dtype=float)


GRID = generate_feasible_grid()


def x3_from_x12(x: np.ndarray, demand: float = DEMAND) -> float:
    return demand - x[0] - x[1]


def nearest_grid_point(x: np.ndarray, grid: np.ndarray = GRID) -> np.ndarray:
    idx = np.argmin(np.sum((grid - x) ** 2, axis=1))
    return grid[idx].copy()


def neighbor_points(x: np.ndarray, step: float = GRID_STEP, demand: float = DEMAND) -> np.ndarray:
    candidates = []
    for dx1 in (-step, 0.0, step):
        for dx2 in (-step, 0.0, step):
            if dx1 == 0.0 and dx2 == 0.0:
                continue
            y = np.array([x[0] + dx1, x[1] + dx2])
            if y[0] < -1e-9 or y[1] < -1e-9:
                continue
            if y[0] + y[1] > demand + 1e-9:
                continue
            y = np.maximum(y, 0.0)
            candidates.append(np.round(y, 10))
    if not candidates:
        return np.empty((0, 2))
    # unique rows
    arr = np.array(candidates)
    arr = np.unique(arr, axis=0)
    return arr


# ---------------------------
# Shock process
# ---------------------------
def simulate_shock_path(T: int = TIME_STEPS, disruption_time: int = DISRUPTION_TIME) -> np.ndarray:
    """
    One-dimensional disruption state xi_t on the primary route.
    Higher xi_t means lower effective capacity.
    """
    xi = np.zeros(T)
    xi[0] = 0.4

    dt = 1.0
    sigma = 0.18

    for t in range(T - 1):
        if t < disruption_time:
            theta = 0.5   # calm regime
            kappa = 0.28
        else:
            theta = 4.8   # disrupted regime
            kappa = 0.22

        xi[t + 1] = xi[t] + kappa * (theta - xi[t]) * dt + sigma * math.sqrt(dt) * RNG.normal()
        xi[t + 1] = np.clip(xi[t + 1], 0.0, 5.8)

    return xi


def capacities_from_shock(xi_t: float) -> tuple[float, float, float]:
    primary = np.clip(BASE_CAPACITY_PRIMARY - xi_t, 1.5, BASE_CAPACITY_PRIMARY)
    backup = BASE_CAPACITY_BACKUP
    consolidation = BASE_CAPACITY_CONSOLIDATION
    return primary, backup, consolidation


# ---------------------------
# Cost model
# ---------------------------
def routing_cost(
    x: np.ndarray,
    x_prev: np.ndarray,
    capacities: tuple[float, float, float],
    shock: float,
    demand: float = DEMAND,
) -> float:
    """
    Reduced-form non-convex stage cost.

    x[0] = flow on disrupted primary route
    x[1] = flow on backup route
    x3   = remaining flow through consolidation route

    The non-convexity is generated by:
    - congestion penalties,
    - switching/inertia penalties,
    - a persistent local basin near the legacy routing pattern,
    - a deeper post-disruption basin near the globally better rerouted pattern.
    """
    x1, x2 = float(x[0]), float(x[1])
    x3 = demand - x1 - x2
    if x1 < -1e-9 or x2 < -1e-9 or x3 < -1e-9:
        return np.inf

    cap1, cap2, cap3 = capacities

    # Base transport costs
    base = 1.00 * x1 + 1.28 * x2 + 1.12 * x3

    # Congestion / overflow penalties
    congestion = (
        1.55 * max(0.0, x1 - cap1) ** 2
        + 0.60 * max(0.0, x2 - cap2) ** 2
        + 0.50 * max(0.0, x3 - cap3) ** 2
    )

    # Switching cost from previous control
    x3_prev = demand - x_prev[0] - x_prev[1]
    switch = 0.22 * ((x1 - x_prev[0]) ** 2 + (x2 - x_prev[1]) ** 2 + (x3 - x3_prev) ** 2)

    # Shock severity in [0,1]
    severity = np.clip(shock / 5.0, 0.0, 1.0)

    # Legacy configuration (historically cheap, but fragile after disruption)
    legacy = np.array([7.0, 1.4])

    # Robust rerouted configuration
    robust = np.array([2.0, 5.2])

    # Local basin persists due to contracts / inertia / habitual routing
    local_basin = -(3.9 - 1.1 * severity) * np.exp(
        -(((x1 - legacy[0]) ** 2) / 2.2 + ((x2 - legacy[1]) ** 2) / 1.4)
    )

    # Global basin deepens after disruption when rerouting becomes truly beneficial
    global_basin = -(1.8 + 4.0 * severity) * np.exp(
        -(((x1 - robust[0]) ** 2) / 2.4 + ((x2 - robust[1]) ** 2) / 2.2)
    )

    # Ridge separating the basins
    ridge = 1.1 * np.exp(-(((x1 - 4.5) ** 2) / 0.8 + ((x2 - 3.3) ** 2) / 2.0))

    return base + congestion + switch + local_basin + global_basin + ridge


def evaluate_on_grid(
    x_prev: np.ndarray,
    capacities: tuple[float, float, float],
    shock: float,
    grid: np.ndarray = GRID,
) -> np.ndarray:
    vals = np.empty(len(grid))
    for i, x in enumerate(grid):
        vals[i] = routing_cost(x, x_prev, capacities, shock)
    return vals


# ---------------------------
# Classical local solver
# ---------------------------
def local_descent_solver(
    x_prev: np.ndarray,
    capacities: tuple[float, float, float],
    shock: float,
    max_iter: int = 200,
) -> np.ndarray:
    """
    Local grid-descent benchmark that mimics a local HJB-style update.
    """
    x_curr = nearest_grid_point(x_prev)
    curr_val = routing_cost(x_curr, x_prev, capacities, shock)

    for _ in range(max_iter):
        nbrs = neighbor_points(x_curr)
        if len(nbrs) == 0:
            break

        vals = np.array([routing_cost(y, x_prev, capacities, shock) for y in nbrs])
        best_idx = np.argmin(vals)
        best_x = nbrs[best_idx]
        best_val = vals[best_idx]

        if best_val + 1e-12 < curr_val:
            x_curr = best_x
            curr_val = best_val
        else:
            break

    return x_curr


# ---------------------------
# Tuy-style discrete elimination search
# ---------------------------
def tuy_cut_search(
    x_prev: np.ndarray,
    capacities: tuple[float, float, float],
    shock: float,
    grid: np.ndarray = GRID,
    max_cuts: int = 6,
):
    """
    Discrete proxy for a Tuy-style cut procedure.

    Steps:
    1. Find the local trap from the current incumbent.
    2. Find the best candidate globally on the current candidate set.
    3. If local and global differ, construct a separating cut that keeps the
       global point and removes the local-trap side.
    4. Repeat.

    Returns:
        final_x, final_val, cut_records
    """
    candidate_mask = np.ones(len(grid), dtype=bool)
    cut_records = []

    for _ in range(max_cuts):
        candidates = grid[candidate_mask]
        candidate_vals = np.array([routing_cost(x, x_prev, capacities, shock) for x in candidates])

        # Global best over current candidate set
        g_idx = np.argmin(candidate_vals)
        global_x = candidates[g_idx]
        global_val = candidate_vals[g_idx]

        # Local benchmark from incumbent
        local_x = local_descent_solver(x_prev, capacities, shock)
        local_val = routing_cost(local_x, x_prev, capacities, shock)

        if np.linalg.norm(local_x - global_x) < 1e-9:
            return global_x, global_val, cut_records

        # Construct a separating cut: perpendicular bisector between local and global
        n = local_x - global_x
        if np.linalg.norm(n) < 1e-12:
            return global_x, global_val, cut_records

        midpoint = 0.5 * (local_x + global_x)
        b = float(np.dot(n, midpoint))

        # Keep the side containing the global point
        new_mask = candidate_mask.copy()
        for i, x in enumerate(grid):
            if not candidate_mask[i]:
                continue
            if np.dot(n, x) > b + 1e-10:
                new_mask[i] = False

        # Ensure the global point is retained
        idx_global_grid = np.argmin(np.sum((grid - global_x) ** 2, axis=1))
        new_mask[idx_global_grid] = True

        cut_records.append(
            {
                "local_x": local_x.copy(),
                "global_x": global_x.copy(),
                "normal": n.copy(),
                "b": b,
            }
        )

        # If no elimination happened, stop
        if np.array_equal(new_mask, candidate_mask):
            return global_x, global_val, cut_records

        candidate_mask = new_mask

    # Final best point
    candidates = grid[candidate_mask]
    candidate_vals = np.array([routing_cost(x, x_prev, capacities, shock) for x in candidates])
    g_idx = np.argmin(candidate_vals)
    global_x = candidates[g_idx]
    global_val = candidate_vals[g_idx]
    return global_x, global_val, cut_records


# ---------------------------
# Simulation
# ---------------------------
def run_simulation(T: int = TIME_STEPS, disruption_time: int = DISRUPTION_TIME) -> SimulationResult:
    shock = simulate_shock_path(T=T, disruption_time=disruption_time)
    primary_capacity = np.zeros(T)

    local_cost = np.zeros(T)
    tuy_cost = np.zeros(T)

    local_x1 = np.zeros(T)
    local_x2 = np.zeros(T)
    tuy_x1 = np.zeros(T)
    tuy_x2 = np.zeros(T)

    # Start both policies near pre-disruption routing pattern
    x_local_prev = np.array([6.8, 1.6])
    x_tuy_prev = np.array([6.8, 1.6])

    for t in range(T):
        capacities = capacities_from_shock(shock[t])
        primary_capacity[t] = capacities[0]

        # Classical benchmark
        x_local = local_descent_solver(x_local_prev, capacities, shock[t])
        c_local = routing_cost(x_local, x_local_prev, capacities, shock[t])

        # Tuy-style search
        x_tuy, c_tuy, _ = tuy_cut_search(x_tuy_prev, capacities, shock[t])

        local_x1[t], local_x2[t] = x_local
        tuy_x1[t], tuy_x2[t] = x_tuy

        local_cost[t] = c_local
        tuy_cost[t] = c_tuy

        x_local_prev = x_local
        x_tuy_prev = x_tuy

    return SimulationResult(
        t=np.arange(T),
        shock=shock,
        primary_capacity=primary_capacity,
        local_cost=local_cost,
        tuy_cost=tuy_cost,
        local_x1=local_x1,
        local_x2=local_x2,
        tuy_x1=tuy_x1,
        tuy_x2=tuy_x2,
    )


# ---------------------------
# Figure 1
# ---------------------------
def build_network_figure(output_dir: Path) -> None:
    G = nx.DiGraph()

    nodes = ["S", "H1", "H2", "H3", "D"]
    G.add_nodes_from(nodes)

    edges = [
        ("S", "H1", {"capacity": "10"}),
        ("S", "H2", {"capacity": "8"}),
        ("H1", "H3", {"capacity": "4"}),
        ("H2", "H3", {"capacity": "7"}),
        ("H1", "D", {"capacity": "3"}),
        ("H2", "D", {"capacity": "6"}),
        ("H3", "D", {"capacity": "9"}),
    ]
    G.add_edges_from([(u, v, attrs) for u, v, attrs in edges])

    pos = {
        "S": (0.0, 0.5),
        "H1": (1.0, 0.9),
        "H2": (1.0, 0.1),
        "H3": (2.1, 0.5),
        "D": (3.2, 0.5),
    }

    plt.figure(figsize=(10, 5.8))
    ax = plt.gca()

    nx.draw_networkx_nodes(G, pos, node_size=2200, ax=ax)
    nx.draw_networkx_labels(G, pos, font_size=12, font_weight="bold", ax=ax)

    normal_edges = [(u, v) for u, v, _ in edges if (u, v) != ("H1", "D")]
    disrupted_edge = [("H1", "D")]

    nx.draw_networkx_edges(
        G, pos,
        edgelist=normal_edges,
        width=2.0,
        arrows=True,
        arrowsize=18,
        ax=ax,
        connectionstyle="arc3,rad=0.02",
    )

    nx.draw_networkx_edges(
        G, pos,
        edgelist=disrupted_edge,
        width=3.0,
        style="dashed",
        arrows=True,
        arrowsize=18,
        ax=ax,
        connectionstyle="arc3,rad=0.02",
    )

    edge_labels = {(u, v): f"cap={attrs['capacity']}" for u, v, attrs in edges}
    nx.draw_networkx_edge_labels(G, pos, edge_labels=edge_labels, font_size=10, ax=ax)

    ax.annotate(
        "Disruption point\n(reduced effective capacity)",
        xy=(2.1, 0.73),
        xytext=(1.9, 1.12),
        arrowprops=dict(arrowstyle="->", lw=1.2),
        fontsize=10,
        ha="center",
    )

    ax.annotate(
        "Alternative rerouting corridor",
        xy=(2.02, 0.27),
        xytext=(2.35, -0.08),
        arrowprops=dict(arrowstyle="->", lw=1.2),
        fontsize=10,
        ha="center",
    )

    ax.text(
        0.0,
        -0.22,
        "S = Supplier, H1/H2/H3 = intermediate hubs or ports, D = Destination",
        fontsize=10,
    )

    plt.title("Figure 1. Five-node supply chain network with disruption")
    plt.axis("off")
    plt.tight_layout()
    plt.savefig(output_dir / "figure1_network_setup.png", dpi=300, bbox_inches="tight")
    plt.close()


# ---------------------------
# Figure 2
# ---------------------------
def build_geometric_cut_figure(output_dir: Path, sim: SimulationResult) -> None:
    # Use the first period immediately after disruption for the landscape
    t0 = DISRUPTION_TIME + 1
    shock = sim.shock[t0]
    capacities = capacities_from_shock(shock)

    # Use the pre-disruption control as the incumbent to visualize the trap
    x_prev = np.array([sim.local_x1[t0 - 1], sim.local_x2[t0 - 1]])

    xs = np.arange(0.0, DEMAND + GRID_STEP, GRID_STEP)
    ys = np.arange(0.0, DEMAND + GRID_STEP, GRID_STEP)
    X1, X2 = np.meshgrid(xs, ys)
    Z = np.full_like(X1, np.nan, dtype=float)

    for i in range(X1.shape[0]):
        for j in range(X1.shape[1]):
            x = np.array([X1[i, j], X2[i, j]])
            if x.sum() <= DEMAND + 1e-12:
                Z[i, j] = routing_cost(x, x_prev, capacities, shock)

    # Compute local and Tuy points consistently with the simulation machinery
    local_x = local_descent_solver(x_prev, capacities, shock)
    tuy_x, _, cuts = tuy_cut_search(x_prev, capacities, shock)

    plt.figure(figsize=(8.4, 6.8))
    ax = plt.gca()

    zvals = Z[np.isfinite(Z)]
    levels = np.linspace(np.nanmin(zvals), np.nanpercentile(zvals, 98), 18)
    contour = ax.contour(X1, X2, Z, levels=levels, linewidths=1.0)
    ax.clabel(contour, inline=True, fontsize=8, fmt="%.1f")

    # Feasible region boundary
    ax.plot([0, DEMAND, 0, 0], [0, 0, DEMAND, 0], linewidth=1.5)

    ax.plot(local_x[0], local_x[1], marker="o", markersize=8)
    ax.annotate(
        "Local trap",
        xy=local_x,
        xytext=(local_x[0] + 0.9, local_x[1] + 1.0),
        arrowprops=dict(arrowstyle="->", lw=1.1),
        fontsize=10,
    )

    ax.plot(tuy_x[0], tuy_x[1], marker="*", markersize=12)
    ax.annotate(
        "Global minimum",
        xy=tuy_x,
        xytext=(max(0.5, tuy_x[0] - 1.2), min(DEMAND - 0.5, tuy_x[1] + 1.2)),
        arrowprops=dict(arrowstyle="->", lw=1.1),
        fontsize=10,
    )

    # Draw the first computed cut if available
    if cuts:
        cut = cuts[0]
        n = cut["normal"]
        b = cut["b"]

        # Solve n1*x + n2*y = b for plotting
        x_line = np.linspace(0, DEMAND, 400)
        if abs(n[1]) > 1e-12:
            y_line = (b - n[0] * x_line) / n[1]
            mask = (y_line >= 0) & (x_line >= 0) & (x_line + y_line <= DEMAND)
            ax.plot(x_line[mask], y_line[mask], linewidth=2.2)
            if np.any(mask):
                mid_idx = np.where(mask)[0][len(np.where(mask)[0]) // 2]
                ax.text(x_line[mid_idx], y_line[mid_idx] + 0.35, "Tuy cut", fontsize=10)

        # Shade the eliminated side on the grid
        eliminated = []
        kept = []
        for x in GRID:
            if np.dot(n, x) > b + 1e-10:
                eliminated.append(x)
            else:
                kept.append(x)
        eliminated = np.array(eliminated)
        if len(eliminated) > 0:
            ax.scatter(eliminated[:, 0], eliminated[:, 1], s=6, alpha=0.12)
            ax.text(local_x[0] - 0.3, max(0.3, local_x[1] - 1.0), "Eliminated\nsuboptimal region", fontsize=10)

    ax.set_xlabel(r"$x_1$: flow on disrupted primary route")
    ax.set_ylabel(r"$x_2$: flow on backup route")
    ax.set_title("Figure 2. Reduced non-convex cost landscape and a Tuy cut")
    ax.set_xlim(0, DEMAND)
    ax.set_ylim(0, DEMAND)
    plt.tight_layout()
    plt.savefig(output_dir / "figure2_geometric_cut.png", dpi=300, bbox_inches="tight")
    plt.close()


# ---------------------------
# Figure 3
# ---------------------------
def build_time_series_figure(output_dir: Path, sim: SimulationResult) -> None:
    plt.figure(figsize=(8.6, 5.9))
    ax = plt.gca()

    ax.plot(sim.t, sim.local_cost, linewidth=2.0, label="Classical HJB (local)")
    ax.plot(sim.t, sim.tuy_cost, linewidth=2.0, label="Tuy-HJB")

    ax.axvline(DISRUPTION_TIME, linestyle="--", linewidth=1.2)
    ymax = max(float(np.max(sim.local_cost)), float(np.max(sim.tuy_cost)))
    ax.text(DISRUPTION_TIME + 0.5, ymax - 0.5, "Disruption", fontsize=10)

    ax.set_xlabel("Time")
    ax.set_ylabel("System cost")
    ax.set_title("Figure 3. Dynamic cost response under disruption")
    ax.legend()
    plt.tight_layout()
    plt.savefig(output_dir / "figure3_time_series_proof.png", dpi=300, bbox_inches="tight")
    plt.close()


# ---------------------------
# Export summary
# ---------------------------
def write_summary_csv(output_dir: Path, sim: SimulationResult) -> None:
    out_file = output_dir / "simulation_summary.csv"
    with out_file.open("w", newline="") as f:
        writer = csv.writer(f)
        writer.writerow([
            "t", "shock", "primary_capacity",
            "local_cost", "tuy_cost",
            "local_x1", "local_x2",
            "tuy_x1", "tuy_x2",
        ])
        for i in range(len(sim.t)):
            writer.writerow([
                int(sim.t[i]),
                float(sim.shock[i]),
                float(sim.primary_capacity[i]),
                float(sim.local_cost[i]),
                float(sim.tuy_cost[i]),
                float(sim.local_x1[i]),
                float(sim.local_x2[i]),
                float(sim.tuy_x1[i]),
                float(sim.tuy_x2[i]),
            ])


# ---------------------------
# Main
# ---------------------------
def main() -> None:
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

    sim = run_simulation()
    build_network_figure(OUTPUT_DIR)
    build_geometric_cut_figure(OUTPUT_DIR, sim)
    build_time_series_figure(OUTPUT_DIR, sim)
    write_summary_csv(OUTPUT_DIR, sim)

    print("Saved files:")
    print(" - figure1_network_setup.png")
    print(" - figure2_geometric_cut.png")
    print(" - figure3_time_series_proof.png")
    print(" - simulation_summary.csv")


if __name__ == "__main__":
    main()
